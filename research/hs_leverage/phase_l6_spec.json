  "state_machine": {
    "initial_state": "IDLE",
    "states": {
      "IDLE": "No active or shadow position and no pending qualifying signal.",
      "SIGNAL_PENDING": "A qualifying completed daily signal has been detected and recorded.",
      "ENTRY_ELIGIBLE": "The next valid trading session and NEXT_OPEN reference are available.",
      "ACTIVE": "A logical tactical sleeve or shadow observation is open; this does not authorize an order.",
      "COOLDOWN_HOLDING": "Existing exposure blocks additional capital until the fixed horizon completes.",
      "CLOSED": "The fixed-horizon logical position has completed and its close record is appended.",
      "FAIL_CLOSED": "Data, threshold, calendar, symbol, schema, or adjustment integrity is invalid."
    },
    "transitions": [
      {
        "from": "IDLE",
        "to": "SIGNAL_PENDING",
        "condition": "final_bar_valid AND threshold_valid AND signal_qualifies",
        "action": "append evaluation record; do not send an order"
      },
      {
        "from": "IDLE",
        "to": "IDLE",
        "condition": "final_bar_valid AND threshold_valid AND NOT signal_qualifies",
        "action": "append non-trigger evaluation record"
      },
      {
        "from": "SIGNAL_PENDING",
        "to": "ENTRY_ELIGIBLE",
        "condition": "next_trading_session_resolved AND entry_reference_available",
        "action": "record planned_entry_date and NEXT_OPEN reference"
      },
      {
        "from": "ENTRY_ELIGIBLE",
        "to": "ACTIVE",
        "condition": "shadow_or_future_approved_execution_record_opened",
        "action": "open logical sleeve record only under the active operating mode"
      },
      {
        "from": "ACTIVE",
        "to": "COOLDOWN_HOLDING",
        "condition": "logical_position_is_open",
        "action": "block new capital and preserve the original entry and holding clock"
      },
      {
        "from": "COOLDOWN_HOLDING",
        "to": "COOLDOWN_HOLDING",
        "condition": "repeat_signal_before_horizon_completion",
        "action": "append repeat_signal=true; do not add capital, reset entry, or restart horizon"
      },
      {
        "from": "COOLDOWN_HOLDING",
        "to": "CLOSED",
        "condition": "selected_fixed_horizon_completed",
        "action": "append close and eligible realized-outcome records"
      },
      {
        "from": "CLOSED",
        "to": "IDLE",
        "condition": "closure_record_persisted",
        "action": "return to evaluation-ready state"
      },
      {
        "from": "ANY_NON_FAIL_STATE",
        "to": "FAIL_CLOSED",
        "condition": "any_fail_closed_condition",
        "action": "signal_status=NO_SIGNAL; append reason; prohibit entry"
      },
      {
        "from": "FAIL_CLOSED",
        "to": "IDLE",
        "condition": "recovery_sequence_complete AND explicit_integrity_review_passed",
        "action": "append recovery record before re-enabling evaluation"
      }
    ],
    "automatic_order_execution": false
